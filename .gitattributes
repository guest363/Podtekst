# Единый EOL по типам файлов: CRLF в *.sh ломает шебанг, LF в *.bat — cmd.
*.sh       text eol=lf
*.command  text eol=lf
*.py       text eol=lf
*.bat      text eol=crlf
*.ps1      text eol=lf
ui/web/frontend/** text=auto eol=lf
ui/web/static/** text=auto eol=lf
src-tauri/crates/mr-summarize/** text=auto eol=lf
