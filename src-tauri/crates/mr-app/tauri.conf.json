{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Podtekst",
  "version": "0.1.6",
  "identifier": "io.github.guest363.podtekst",
  "build": {
    "frontendDist": "../../../ui/web/static",
    "devUrl": "http://127.0.0.1:8765",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "showMenuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "guest363",
    "homepage": "https://github.com/guest363/podtekst",
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md",
      "../../../LICENSES": "LICENSES"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Подтекст — локальная запись созвонов и экрана с ИИ-расшифровкой",
    "longDescription": "Подтекст — 100% локальная запись созвонов, видео экрана и расшифровка (GigaAM-v3 + Whisper) с диаризацией и голосовыми пакетами. Без облаков.",
    "macOS": {
      "minimumSystemVersion": "13.4"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEMkNDODk0NTJDNTRFMkEKUldRcVRzVlNsTWdzSGFFRFgxQ0hJWFZLMi9ZSGdVYldWLzg5TVJSdm1xSHVwTkxtWGd5WEVoMHAK",
      "endpoints": [
        "https://github.com/guest363/podtekst/releases/latest/download/latest.json"
      ]
    }
  }
}
